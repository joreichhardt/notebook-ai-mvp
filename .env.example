# Non-secret configuration; production credentials are mounted from bws on kube1.
NOTEBOOK_PUBLIC_ORIGIN=https://note.yokoma.de
# Internal URL of the self-hosted Supabase gateway; configure actual service name.
NOTEBOOK_SUPABASE_URL=
NOTEBOOK_DATABASE_URL_FILE=/run/secrets/notebook_database_url
NOTEBOOK_SUPABASE_ANON_KEY_FILE=/run/secrets/notebook_supabase_anon_key
# No BWS_ACCESS_TOKEN here: only the host-side fetch process receives it.
# Personal provider lifecycle: administrator-controlled endpoint catalog and SDK secret store.
NOTEBOOK_PROVIDER_ENDPOINTS=[]
NOTEBOOK_PROVIDER_BITWARDEN_API_URL=
NOTEBOOK_PROVIDER_BITWARDEN_IDENTITY_URL=
NOTEBOOK_PROVIDER_BITWARDEN_PROJECT_ID=
NOTEBOOK_PROVIDER_BITWARDEN_ORGANIZATION_ID=
NOTEBOOK_PROVIDER_BITWARDEN_TOKEN_FILE=
# The SDK token is distinct from the host deployment reader and needs limited write permissions.
