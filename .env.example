# Non-secret configuration; production credentials are mounted from bws on kube1.
NOTEBOOK_PUBLIC_ORIGIN=https://note.yokoma.de
# Internal URL of the self-hosted Supabase gateway; configure actual service name.
NOTEBOOK_SUPABASE_URL=
NOTEBOOK_DATABASE_URL_FILE=/run/secrets/notebook_database_url
NOTEBOOK_SUPABASE_ANON_KEY_FILE=/run/secrets/notebook_supabase_anon_key
# Opt-in TXT/Markdown HTTP uploads in app.main (not the login-only app.poc profile).
# Provision/mount the volume private0700 for the API UID; never serve it statically.
NOTEBOOK_LOCAL_UPLOADS_ENABLED=false
NOTEBOOK_LOCAL_STORAGE_ROOT=/var/lib/notebook/originals
# Separate restricted NOINHERIT login, granted notebook_storage_io; never app/admin credentials.
NOTEBOOK_STORAGE_IO_DATABASE_URL_FILE=/run/secrets/notebook_storage_io_database_url
# Separate single-delivery text-worker process; never started inside an HTTP request.
# Requires a process-manager hard deadline; stop automatic restarts on held/nonzero exits.
NOTEBOOK_LOCAL_TEXT_WORKER_ENABLED=false
# Direct notebook_text_scheduler login; provision separately, never use an admin DSN.
# Schema migrations deliberately leave this role NOLOGIN. No automatic role alteration.
NOTEBOOK_TEXT_SCHEDULER_DATABASE_URL_FILE=/run/secrets/notebook_text_scheduler_database_url
# Worker mounts only its app/scheduler DSN files and the private originals volume read-only.
# No BWS_ACCESS_TOKEN here: only the host-side fetch process receives it.
# Personal provider lifecycle: administrator-controlled endpoint catalog and SDK secret store.
NOTEBOOK_PROVIDER_ENDPOINTS=[]
NOTEBOOK_PROVIDER_BITWARDEN_API_URL=
NOTEBOOK_PROVIDER_BITWARDEN_IDENTITY_URL=
NOTEBOOK_PROVIDER_BITWARDEN_PROJECT_ID=
NOTEBOOK_PROVIDER_BITWARDEN_ORGANIZATION_ID=
NOTEBOOK_PROVIDER_BITWARDEN_TOKEN_FILE=
# The SDK token is distinct from the host deployment reader and needs limited write permissions.
